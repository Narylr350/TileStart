<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TileStart.Host\TileStart.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="TileStart.Host.Applications" />
    <Using Include="TileStart.Host.Icons" />
    <Using Include="TileStart.Host.Shell" />
    <Using Include="TileStart.Host.Windowing" />
    <Using Include="TileStart.Host.Navigation" />
    <Using Include="TileStart.Host.Tiles.Models" />
    <Using Include="TileStart.Host.Tiles.Layout" />
    <Using Include="TileStart.Host.Tiles.DragDrop" />
    <Using Include="TileStart.Host.Tiles.Folders" />
    <Using Include="TileStart.Host.Tiles.Settings" />
    <Using Include="TileStart.Host.Persistence" />
    <Using Include="TileStart.Host.Utilities" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\native-layout.xml"
             Link="TestData\native-layout.xml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestData\visual-contracts\*.json"
             Link="TestData\win10-start-specs\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\MainWindow.xaml"
             Link="TestData\Xaml\MainWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\App.xaml"
             Link="TestData\Xaml\App.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Themes\Win11Theme.xaml"
             Link="TestData\Xaml\Win11Theme.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Themes\Win10Theme.xaml"
             Link="TestData\Xaml\Win10Theme.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Themes\Win11LightTheme.xaml"
             Link="TestData\Xaml\Win11LightTheme.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Themes\Win10LightTheme.xaml"
             Link="TestData\Xaml\Win10LightTheme.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Themes\SharedStyles.xaml"
             Link="TestData\Xaml\SharedStyles.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Backup\BackupRestoreWindow.xaml"
             Link="TestData\Xaml\BackupRestoreWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Settings\SettingsWindow.xaml"
             Link="TestData\Xaml\SettingsWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\About\AboutWindow.xaml"
             Link="TestData\Xaml\AboutWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Tiles\Settings\TileSettingsWindow.xaml"
             Link="TestData\Xaml\TileSettingsWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Tiles\Settings\GroupSettingsWindow.xaml"
             Link="TestData\Xaml\GroupSettingsWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Tiles\Settings\SvgIconWindow.xaml"
             Link="TestData\Xaml\SvgIconWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Windowing\TileStartMessageDialog.xaml"
             Link="TestData\Xaml\TileStartMessageDialog.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Updates\UpdateProgressWindow.xaml"
             Link="TestData\Xaml\UpdateProgressWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\**\*.cs"
             Exclude="..\..\src\TileStart.Host\bin\**;..\..\src\TileStart.Host\obj\**"
             Link="TestData\HostSource\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.ShellHook\ShellHook.cpp"
             Link="TestData\NativeSource\ShellHook.cpp"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\*.Injector\*.vcxproj;..\..\src\*.ShellHook\*.vcxproj;..\..\src\*.ShellProbe\*.vcxproj"
             Link="TestData\NativeProjects\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Windowing\StartMotion.cs"
             Link="TestData\Performance\StartMotion.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Shell\StartWindowController.cs"
             Link="TestData\Performance\StartWindowController.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Navigation\SemanticZoomMotion.cs"
             Link="TestData\Performance\SemanticZoomMotion.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Navigation\Win10MenuPopupMotion.cs"
             Link="TestData\Performance\Win10MenuPopupMotion.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Host\Tiles\Folders\Win10FolderMotion.cs"
             Link="TestData\Performance\Win10FolderMotion.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\TileStart.iss"
             Link="TestData\Installer\TileStart.iss"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\TileStart.Injector\main.cpp"
             Link="TestData\Native\InjectorMain.cpp"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.github\workflows\local-hotfix.yml"
             Link="TestData\Automation\local-hotfix.yml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Build-Package.ps1"
             Link="TestData\Automation\Build-Package.ps1"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Install-Local-Hotfix.ps1"
             Link="TestData\Automation\Install-Local-Hotfix.ps1"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
