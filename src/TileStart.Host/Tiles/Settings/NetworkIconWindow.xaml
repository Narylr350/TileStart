<Window x:Class="TileStart.Host.Tiles.Settings.NetworkIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="网络图标"
        Width="500"
        Height="330"
        MinWidth="360"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Style="{StaticResource TileStartDialogWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource TileStartTextBoxStyle}">
            <Setter Property="Height" Value="34" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TileStartButtonStyle}" />
    </Window.Resources>

    <Border Style="{StaticResource TileStartDialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="从网络获取图标" />
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="72"
                        Height="72"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource TileStartLayerBackgroundBrush}"
                        BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TileStartOverlayCornerRadius}">
                    <Image x:Name="PreviewImage"
                           Margin="8"
                           gif:ImageBehavior.RepeatBehavior="Forever"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="图片地址" />
                    <TextBox x:Name="UrlBox" Margin="0,8,0,0" />
                    <Button x:Name="DownloadButton"
                            Width="96"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource TileStartPrimaryButtonStyle}"
                            Content="下载并预览"
                            Click="Download_Click" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}"
                               Text="支持 PNG、JPEG、BMP、GIF、ICO 和 SVG，最大 5 MB。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,12"
                    Background="{StaticResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{StaticResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="76" Margin="0,0,10,0" IsCancel="True" Content="取消" />
                    <Button x:Name="ConfirmButton"
                            Width="76"
                            Style="{StaticResource TileStartPrimaryButtonStyle}"
                            IsEnabled="False"
                            IsDefault="True"
                            Content="使用"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>