<Window x:Class="TileStart.Host.Tiles.Settings.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择颜色"
        Width="506"
        Height="508"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Style="{StaticResource TileStartDialogWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource TileStartButtonStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource TileStartTextBoxStyle}" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource TileStartDialogScrollBarStyle}" />

        <Style x:Key="ChannelLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource TileStartControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource TileStartControlCornerRadius}"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush"
                                        Value="{StaticResource TileStartControlStrokeHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource TileStartDialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="选择颜色" />
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="SpectrumHost"
                        BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource TileStartControlCornerRadius}"
                        ClipToBounds="True"
                        MouseLeftButtonDown="Spectrum_MouseLeftButtonDown"
                        MouseMove="Spectrum_MouseMove"
                        MouseLeftButtonUp="Spectrum_MouseLeftButtonUp">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                <GradientStop x:Name="SpectrumHueStop" Offset="1" Color="#FFFF0000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#FF000000" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Canvas>
                                <Ellipse x:Name="SpectrumThumb"
                                         Width="14"
                                         Height="14"
                                         Stroke="#FFFFFFFF"
                                         StrokeThickness="2"
                                         IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="HueHost"
                        Grid.Row="1"
                        Height="18"
                        Margin="0,12,0,0"
                        BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource TileStartControlCornerRadius}"
                        ClipToBounds="True"
                        MouseLeftButtonDown="Hue_MouseLeftButtonDown"
                        MouseMove="Hue_MouseMove"
                        MouseLeftButtonUp="Hue_MouseLeftButtonUp">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.000" Color="#FFFF0000" />
                                <GradientStop Offset="0.167" Color="#FFFFFF00" />
                                <GradientStop Offset="0.333" Color="#FF00FF00" />
                                <GradientStop Offset="0.500" Color="#FF00FFFF" />
                                <GradientStop Offset="0.667" Color="#FF0000FF" />
                                <GradientStop Offset="0.833" Color="#FFFF00FF" />
                                <GradientStop Offset="1.000" Color="#FFFF0000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Canvas>
                            <Rectangle x:Name="HueThumb"
                                       Width="4"
                                       Height="16"
                                       Fill="#FFFFFFFF"
                                       IsHitTestVisible="False" />
                        </Canvas>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2"
                              Grid.RowSpan="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">
                    <TextBlock Margin="0,0,0,6"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}"
                               FontSize="12"
                               Text="预览" />
                    <Border Height="56"
                            BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <Border x:Name="PreviewSwatch" Margin="1" />
                    </Border>

                    <TextBlock Margin="0,14,0,6"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}"
                               FontSize="12"
                               Text="十六进制" />
                    <TextBox x:Name="HexBox"
                             MaxLength="7"
                             TextChanged="HexBox_TextChanged" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource ChannelLabelStyle}" Text="R" />
                        <TextBox x:Name="RedBox"
                                 Grid.Column="1"
                                 MaxLength="3"
                                 TextChanged="ChannelBox_TextChanged" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource ChannelLabelStyle}"
                                   Text="G" />
                        <TextBox x:Name="GreenBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 MaxLength="3"
                                 TextChanged="ChannelBox_TextChanged" />
                        <TextBlock Grid.Row="4"
                                   Style="{StaticResource ChannelLabelStyle}"
                                   Text="B" />
                        <TextBox x:Name="BlueBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 MaxLength="3"
                                 TextChanged="ChannelBox_TextChanged" />
                    </Grid>

                    <TextBlock Margin="0,14,0,6"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}"
                               FontSize="12"
                               Text="常用颜色" />
                    <ItemsControl x:Name="SwatchList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchStyle}"
                                        Background="{Binding Brush}"
                                        Tag="{Binding Hex}"
                                        ToolTip="{Binding Hex}"
                                        Click="Swatch_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,12"
                    Background="{StaticResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{StaticResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="76" Margin="0,0,10,0" IsCancel="True" Content="取消" />
                    <Button x:Name="ConfirmButton"
                            Width="76"
                            Style="{StaticResource TileStartPrimaryButtonStyle}"
                            IsDefault="True"
                            Content="确定"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
