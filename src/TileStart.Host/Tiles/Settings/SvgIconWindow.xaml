<Window x:Class="TileStart.Host.Tiles.Settings.SvgIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:utilities="clr-namespace:TileStart.Host.Utilities"
        Title="SVG 图标"
        Width="660"
        Height="500"
        MinWidth="580"
        MinHeight="430"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Style="{StaticResource TileStartDialogWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource TileStartButtonStyle}" />
    </Window.Resources>

    <Border Style="{StaticResource TileStartDialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="SVG 源码图标" />
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="SVG 代码" />
                <TextBox x:Name="SourceBox"
                         Grid.Row="1"
                         Margin="0,8,18,0"
                         Padding="10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Foreground="{StaticResource TileStartTextPrimaryBrush}"
                         Background="{StaticResource TileStartLayerBackgroundBrush}"
                         BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                         BorderThickness="1"
                         CaretBrush="White"
                          FontFamily="Cascadia Mono, Consolas"
                          FontSize="11"
                          utilities:SmoothScroll.IsEnabled="True"
                          TextWrapping="NoWrap" />
                <Button Grid.Row="2"
                        Width="96"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource TileStartPrimaryButtonStyle}"
                        Content="验证并预览"
                        Click="Preview_Click" />

                <StackPanel Grid.Column="1" Grid.RowSpan="3">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="预览" />
                    <Border Height="160"
                            Margin="0,8,0,0"
                            Background="{StaticResource TileStartLayerBackgroundBrush}"
                            BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TileStartOverlayCornerRadius}">
                        <Image x:Name="PreviewImage"
                               Margin="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}"
                               Text="仅允许单个 SVG 根元素，不允许脚本、DOCTYPE 或外部资源。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,12"
                    Background="{StaticResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{StaticResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="76" Margin="0,0,10,0" IsCancel="True" Content="取消" />
                    <Button x:Name="ConfirmButton"
                            Width="76"
                            Style="{StaticResource TileStartPrimaryButtonStyle}"
                            IsEnabled="False"
                            IsDefault="True"
                            Content="使用"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>