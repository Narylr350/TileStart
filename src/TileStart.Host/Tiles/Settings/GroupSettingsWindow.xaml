<Window x:Class="TileStart.Host.Tiles.Settings.GroupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TileStart.Host"
        xmlns:settings="clr-namespace:TileStart.Host.Tiles.Settings"
        xmlns:models="clr-namespace:TileStart.Host.Tiles.Models"
        xmlns:utilities="clr-namespace:TileStart.Host.Utilities"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="组设置"
        Width="1100"
        Height="700"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Style="{StaticResource TileStartDialogWindowStyle}"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource TileStartTextBoxStyle}">
            <Setter Property="Height" Value="34" />
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource TileStartComboBoxItemStyle}" />

        <Style TargetType="ComboBox" BasedOn="{StaticResource TileStartComboBoxStyle}">
            <Setter Property="Height" Value="34" />
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource TileStartDialogScrollBarStyle}" />

        <Style x:Key="TilePickerCardStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TileStartCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TileStartControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="{StaticResource TileStartOverlayCornerRadius}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <local:Win10InteractionBorder Background="Transparent"
                                                          UsesSharedPointerLight="True"
                                                          RevealRadius="96"
                                                          HoverFillOpacity="0.09"
                                                          RevealBorderOpacity="0.42"
                                                          IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Margin="8,0,20,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TileStartTextPrimaryBrush}" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border x:Name="SelectedBadge" Grid.Column="1" Width="18" Height="18"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Background="{x:Static local:Win10Theme.ContextMenuHighlightBrush}"
                                             CornerRadius="{StaticResource TileStartControlCornerRadius}"
                                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                        </Border.RenderTransform>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{x:Static local:Win10Theme.AccentForegroundBrush}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                                    </Border>
                                </Grid>
                            </local:Win10InteractionBorder>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background"
                                        Value="{StaticResource TileStartControlHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush"
                                        Value="{StaticResource TileStartControlStrokeHoverBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.10">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.10">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background"
                                        Value="{StaticResource TileStartControlPressedBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush"
                                        Value="{x:Static local:Win10Theme.ContextMenuHighlightBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.09" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.72" Duration="0:0:0.09" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedBadge"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.72" Duration="0:0:0.09" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TileStartButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TileStartPrimaryButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface"
            Style="{StaticResource TileStartDialogSurfaceStyle}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                <TranslateTransform Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" FontSize="14" FontWeight="SemiBold" Text="自定义组" />
                    <TextBlock x:Name="DialogDescriptionText" Margin="0,2,0,0"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}" FontSize="10"
                               Text="设置容器跨度并选择要放入的磁贴" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True" Content="&#xE8BB;" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GroupPropertiesColumn" Width="220" />
                    <ColumnDefinition x:Name="PropertiesGapColumn" Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="GroupPropertiesPanel" Grid.Column="0">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="组属性" />
                    <TextBlock Margin="0,18,0,6" Foreground="{StaticResource TileStartTextPrimaryBrush}" Text="名称" />
                    <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />

                    <TextBlock Margin="0,18,0,6" Foreground="{StaticResource TileStartTextPrimaryBrush}" Text="宽度" />
                    <ComboBox x:Name="WidthBox" SelectedValuePath="Tag" SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="1 列" Tag="1" />
                        <ComboBoxItem Content="2 列" Tag="2" />
                        <ComboBoxItem Content="3 列" Tag="3" />
                        <ComboBoxItem Content="4 列（原版宽度）" Tag="4" />
                        <ComboBoxItem Content="5 列" Tag="5" />
                        <ComboBoxItem Content="6 列" Tag="6" />
                        <ComboBoxItem Content="7 列" Tag="7" />
                        <ComboBoxItem Content="8 列" Tag="8" />
                    </ComboBox>

                    <TextBlock Margin="0,18,0,6" Foreground="{StaticResource TileStartTextPrimaryBrush}" Text="高度" />
                    <ComboBox x:Name="HeightBox" SelectedValuePath="Tag" SelectionChanged="Settings_Changed">
                        <ComboBoxItem Content="自动（兼容旧组）" Tag="0" />
                        <ComboBoxItem Content="1 行" Tag="1" />
                        <ComboBoxItem Content="2 行" Tag="2" />
                        <ComboBoxItem Content="3 行" Tag="3" />
                        <ComboBoxItem Content="4 行" Tag="4" />
                        <ComboBoxItem Content="5 行" Tag="5" />
                        <ComboBoxItem Content="6 行" Tag="6" />
                        <ComboBoxItem Content="7 行" Tag="7" />
                        <ComboBoxItem Content="8 行" Tag="8" />
                    </ComboBox>

                    <StackPanel Margin="0,22,0,0">
                    <TextBlock Foreground="{StaticResource TileStartTextPrimaryBrush}" FontWeight="SemiBold" Text="尺寸说明" />
                    <Border Height="1" Margin="0,8,0,9" Background="{StaticResource TileStartDividerBrush}" />
                        <TextBlock Foreground="{StaticResource TileStartTextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap"
                                   Text="每个单位对应一个中磁贴。小、宽和大磁贴会按实际占格自动排布。" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="选择磁贴" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TileStartTextSecondaryBrush}"
                                   Text="{Binding SelectedCountText}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <TextBox x:Name="SearchBox" Padding="36,0,10,0" TextChanged="SearchBox_TextChanged" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource TileStartTextSecondaryBrush}" FontSize="14"
                                   Text="&#xE721;" IsHitTestVisible="False" />
                        <TextBlock Margin="36,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TileStartTextTertiaryBrush}"
                                   Text="搜索应用和磁贴" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TileStartTextSecondaryBrush}"
                                   FontSize="11" Text="已选磁贴始终置顶" />
                        <Button HorizontalAlignment="Right" Height="28" MinWidth="58" Padding="10,0"
                                Style="{StaticResource DialogButtonStyle}" Content="清空" Click="ClearSelection_Click" />
                    </Grid>
                    <Border Grid.Row="3"
                            Padding="10"
                            Background="{StaticResource TileStartLayerBackgroundBrush}"
                            BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TileStartControlCornerRadius}">
                        <ListBox ItemsSource="{Binding TileOptionRows}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 utilities:SmoothScroll.IsEnabled="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:GroupTileOptionRow}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton DataContext="{Binding First}"
                                                      Style="{StaticResource TilePickerCardStyle}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <ToggleButton Grid.Column="2"
                                                      DataContext="{Binding Second}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton"
                                                       BasedOn="{StaticResource TilePickerCardStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="DataContext" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="实时预览" />
                    <TextBlock x:Name="PreviewSizeText" Grid.Row="1" Margin="0,6,0,12"
                               Foreground="{StaticResource TileStartTextSecondaryBrush}" />
                    <Border Grid.Row="2"
                            Padding="16"
                            Background="{StaticResource TileStartWindowBackgroundBrush}"
                            BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TileStartOverlayCornerRadius}">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <StackPanel Width="{Binding PreviewGroup.VisualWidth}">
                                <TextBlock Height="32" VerticalAlignment="Center"
                                           Foreground="{StaticResource TileStartTextPrimaryBrush}"
                                           FontSize="14" Text="{Binding PreviewGroup.Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Canvas Width="{Binding PreviewGroup.PixelWidth}"
                                        Height="{Binding PreviewGroup.PixelHeight}"
                                        HorizontalAlignment="Center">
                                    <ItemsControl Width="{Binding PreviewGroup.PixelWidth}"
                                                  Height="{Binding PreviewGroup.PixelHeight}"
                                                  ItemsSource="{Binding PreviewGroup.Tiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding DisplayTop}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TileItem}">
                                                <Border Width="{Binding PixelWidth}" Height="{Binding PixelHeight}"
                                                        Background="{Binding BackgroundBrush}">
                                                    <Grid>
                                                        <Image Width="{Binding IconSize}" Height="{Binding IconSize}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Source="{Binding Icon}" Stretch="Uniform" />
                                                        <TextBlock Margin="7,0,7,5" HorizontalAlignment="Left"
                                                                   VerticalAlignment="Bottom"
                                                                   Foreground="{Binding ForegroundBrush}" FontSize="11"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </StackPanel>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,12,0,0" MinHeight="18"
                               Foreground="{StaticResource TileStartErrorBrush}"
                               Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{StaticResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{StaticResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0" Style="{StaticResource DialogButtonStyle}" Content="取消"
                            Click="Close_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="保存"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>