<Window x:Class="TileStart.Host.Updates.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windowing="clr-namespace:TileStart.Host.Windowing"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="正在更新 TileStart"
        Width="520"
        Height="290"
        MinWidth="440"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        Style="{StaticResource TileStartDialogWindowStyle}"
        windowing:DialogWindowMotion.IsCloseAnimationEnabled="False"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource TileStartDialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE895;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="正在更新 TileStart" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="30,26,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="正在获取校验信息…" />
                <TextBlock x:Name="DetailText"
                           Grid.Row="1"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource TileStartTextSecondaryBrush}"
                           Text="即将开始下载" />
                <ProgressBar x:Name="DownloadProgress"
                             Grid.Row="3"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Foreground="{DynamicResource TileStartAccentBrush}"
                             IsIndeterminate="True" />
                <Grid Grid.Row="5">
                    <TextBlock x:Name="StageText"
                               Foreground="{DynamicResource TileStartTextSecondaryBrush}"
                               Text="获取 SHA-256 校验文件" />
                    <TextBlock x:Name="PercentageText"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="20,0"
                    Background="{DynamicResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{DynamicResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Button x:Name="CancelButton"
                        MinWidth="90"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TileStartButtonStyle}"
                        Click="CancelButton_Click"
                        Content="取消" />
            </Border>
        </Grid>
    </Border>
</Window>
