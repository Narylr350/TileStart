<Window x:Class="TileStart.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TileStart.Host"
        xmlns:icons="clr-namespace:TileStart.Host.Icons"
        xmlns:apps="clr-namespace:TileStart.Host.Applications"
        xmlns:models="clr-namespace:TileStart.Host.Tiles.Models"
        xmlns:layouts="clr-namespace:TileStart.Host.Tiles.Layout"
        xmlns:utilities="clr-namespace:TileStart.Host.Utilities"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="TileStart"
        Width="1252"
        Height="768"
        MinWidth="680"
        MinHeight="480"
        Background="Transparent"
        FontFamily="{StaticResource TileStartContentFont}"
        FontSize="14"
        FontWeight="Normal"
        Foreground="{StaticResource TileStartTextPrimaryBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewTextInput="Window_PreviewTextInput">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
        </Style>
        <Style x:Key="StartVerticalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="{x:Static local:Win10VisualMetrics.TileScrollBarWidth}" />
            <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.TileScrollBarMargin}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb"
                                           Width="2"
                                           MinHeight="{x:Static local:Win10VisualMetrics.TileScrollBarThumbMinHeight}"
                                           Margin="{x:Static local:Win10VisualMetrics.TileScrollBarThumbRestMargin}"
                                           HorizontalAlignment="Right"
                                           Background="{DynamicResource TileStartScrollBarThumbRestBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Width"
                                        Value="{x:Static local:Win10VisualMetrics.TileScrollBarThumbMouseWidth}" />
                                <Setter TargetName="ScrollThumb" Property="Margin" Value="0" />
                                <Setter TargetName="ScrollThumb" Property="Background"
                                        Value="{DynamicResource TileStartScrollBarThumbHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Panel.ZIndex="1"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Orientation="Vertical"
                                       Style="{StaticResource StartVerticalScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="{x:Static local:Win10VisualMetrics.NavigationItemHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Win10InteractionBorder x:Name="Background"
                                                      Background="{TemplateBinding Background}"
                                                      CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                                                      IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                                      RevealRadius="88">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="{x:Static local:Win10VisualMetrics.CollapsedNavigationGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                 <ContentPresenter Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Content="{TemplateBinding Content}"
                                                   TextElement.FontFamily="Segoe MDL2 Assets"
                                                   TextElement.FontSize="{x:Static local:Win10VisualMetrics.NavigationGlyphFontSize}"
                                                   TextElement.Foreground="{TemplateBinding Foreground}" />
                                 <TextBlock Grid.Column="1"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            FontFamily="{StaticResource TileStartContentFont}"
                                            FontSize="{x:Static local:Win10VisualMetrics.NavigationTextFontSize}"
                                           Text="{TemplateBinding Tag}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </local:Win10InteractionBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppRowStyle" TargetType="Button">
            <Setter Property="Height" Value="{x:Static local:Win10VisualMetrics.AllAppsRowHeight}" />
            <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.AllAppsItemMargin}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Win10InteractionBorder x:Name="Background"
                                                      Background="{TemplateBinding Background}"
                                                      CornerRadius="{StaticResource TileStartControlCornerRadius}"
                                                      HoverFillOpacity="0.10"
                                                      IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                                      PressedFillOpacity="0.20"
                                                      RevealRadius="104">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </local:Win10InteractionBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TileStartDefaultTileBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Grid IsHitTestVisible="False">
                                        <Border x:Name="TilePrimaryFocusVisual"
                                                Margin="{x:Static local:Win10VisualMetrics.TileFocusVisualMargin}"
                                                BorderBrush="{DynamicResource TileStartTextPrimaryBrush}"
                                                BorderThickness="{x:Static local:Win10VisualMetrics.TilePrimaryFocusBorderThickness}" />
                                        <Border x:Name="TileSecondaryFocusVisual"
                                                BorderBrush="{DynamicResource TileStartFocusSecondaryBrush}"
                                                BorderThickness="{x:Static local:Win10VisualMetrics.TileSecondaryFocusBorderThickness}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Win10InteractionBorder x:Name="TileBorder"
                                                      Background="{TemplateBinding Background}"
                                                      CornerRadius="{StaticResource TileStartTileCornerRadius}"
                                                      HoverFillOpacity="0"
                                                      IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                                      PressedFillOpacity="0"
                                                      RevealBorderOpacity="0.5"
                                                      RevealRadius="96"
                                                      UsesSharedPointerLight="True"
                                                      UsesTilePressedScale="True"
                                                      SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </local:Win10InteractionBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource TileStartContextMenuStyle}">
            <EventSetter Event="Opened" Handler="StartContextMenu_Opened" />
            <EventSetter Event="Closed" Handler="StartContextMenu_Closed" />
        </Style>
        <Style x:Key="LetterHeaderStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.AllAppsItemMargin}" />
            <Setter Property="Padding" Value="{x:Static local:Win10VisualMetrics.AllAppsGroupHeaderPadding}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{x:Static local:Win10VisualMetrics.AllAppsGroupHeaderFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Win10InteractionBorder x:Name="Background"
                                                      Background="{TemplateBinding Background}"
                                                      CornerRadius="{StaticResource TileStartControlCornerRadius}"
                                                      HoverFillOpacity="0.10"
                                                      IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                                      PressedFillOpacity="0.20"
                                                      RevealRadius="84">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </local:Win10InteractionBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlphabetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{x:Static local:Win10VisualMetrics.AlphabetCellSize}" />
            <Setter Property="Height" Value="{x:Static local:Win10VisualMetrics.AlphabetCellSize}" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Foreground" Value="{StaticResource TileStartTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{x:Static local:Win10VisualMetrics.AlphabetFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Win10InteractionBorder x:Name="Background"
                                                      Background="{TemplateBinding Background}"
                                                      CornerRadius="{StaticResource TileStartControlCornerRadius}"
                                                      HoverFillOpacity="0.10"
                                                      IsPressedState="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                                      PressedFillOpacity="0.20"
                                                      RevealRadius="72">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </local:Win10InteractionBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsGlyph}" Value="True">
                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AppEntryTemplate">
            <StackPanel>
                <Button Tag="{Binding}"
                        Click="AppButton_Click"
                        PreviewMouseLeftButtonDown="AppButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="AppButton_PreviewMouseMove">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AppRowStyle}">
                            <Setter Property="ContextMenuService.IsEnabled" Value="True" />
                            <Style.Triggers>
                                <!-- Application-list folders are navigation containers, not launch targets.
                                     Do not expose the regular app actions as a non-functional empty promise. -->
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="ContextMenuService.IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                    >
                            <MenuItem Header="固定到 TileStart 磁贴区"
                                      Tag="PinStart"
                                      Click="PinAppToStart_Click">
                                <MenuItem.Icon>
                                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE718;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="从 TileStart 磁贴区取消固定"
                                      Tag="UnpinStart"
                                      Visibility="Collapsed"
                                      Click="UnpinAppFromStart_Click">
                                <MenuItem.Icon>
                                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE77A;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="从应用列表取消固定"
                                      Tag="RemoveCustomApp"
                                      Visibility="Collapsed"
                                      Click="RemoveCustomApp_Click">
                                <MenuItem.Icon>
                                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="更多">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanOpenFileLocation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanPinToTaskbar}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                                <MenuItem Header="固定到任务栏"
                                          Click="PinAppToTaskbar_Click">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanPinToTaskbar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="打开文件所在的位置"
                                          Click="OpenAppFileLocation_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Text="&#xE838;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="卸载"
                                      Click="UninstallApp_Click">
                                <MenuItem.Icon>
                                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE74D;" />
                                </MenuItem.Icon>
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="{x:Static icons:Win10IconMetrics.ClassicAppLogoGridLength}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{x:Static icons:Win10IconMetrics.ClassicAppLogoLayoutSize}"
                              Height="{x:Static icons:Win10IconMetrics.ClassicAppLogoLayoutSize}"
                              HorizontalAlignment="Left">
                            <TextBlock x:Name="AppInitial"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="{Binding Initial}"
                                       Visibility="Collapsed" />
                            <Image x:Name="AppIcon"
                                   Width="{x:Static icons:Win10IconMetrics.ClassicAppLogoImageSize}"
                                   Height="{x:Static icons:Win10IconMetrics.ClassicAppLogoImageSize}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Icon}"
                                   Stretch="Uniform" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource TileStartContentFont}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock x:Name="FolderChevron"
                                   Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="{Binding FolderChevron}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>
                <ItemsControl Margin="20,0,0,0"
                              ClipToBounds="True"
                              ItemsSource="{Binding Children}"
                              ItemTemplate="{DynamicResource AppEntryTemplate}"
                              Tag="{Binding}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="AppInitial" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="FolderChevron" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ContextMenu x:Key="TileContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="从 TileStart 磁贴区取消固定"
                      Click="UnpinTile_Click">
                <MenuItem.Icon>
                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE77A;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="解散文件夹"
                      Tag="DissolveFolder"
                      Visibility="Collapsed"
                      Click="DissolveFolder_Click" />
            <MenuItem Header="调整大小">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTileFolder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem Header="小"
                          Tag="Small"
                          IsCheckable="True"
                          Click="ResizeTile_Click">
                    <MenuItem.Icon>
                        <Border Width="13" Height="13"
                                BorderBrush="White"
                                BorderThickness="1.5" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="中"
                          Tag="Medium"
                          IsCheckable="True"
                          Click="ResizeTile_Click">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16"
                                BorderBrush="White"
                                BorderThickness="1.5" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="宽"
                          Tag="Wide"
                          IsCheckable="True"
                          Click="ResizeTile_Click">
                    <MenuItem.Icon>
                        <Border Width="18" Height="10"
                                BorderBrush="White"
                                BorderThickness="1.5" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="大"
                          Tag="Large"
                          IsCheckable="True"
                          Click="ResizeTile_Click">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16"
                                Background="White" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="更多">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTileFolder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem Header="打开文件所在的位置"
                          Tag="OpenFileLocation"
                          Click="OpenTileFileLocation_Click">
                    <MenuItem.Icon>
                        <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Text="&#xE838;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="固定到任务栏"
                          Tag="PinTaskbar"
                          Click="PinTileToTaskbar_Click" />
                <MenuItem Header="以管理员身份运行"
                          Click="RunTileAsAdministrator_Click">
                    <MenuItem.Icon>
                        <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Text="&#xE83D;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding SettingsMenuHeader}"
                      Click="TileSettings_Click">
                <MenuItem.Icon>
                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE713;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="文件夹内容…"
                      Click="FolderContents_Click">
                <MenuItem.Style>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource TileStartMenuItemStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTileFolder}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.Icon>
                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE8B7;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="卸载"
                      Tag="Uninstall"
                      Click="UninstallTile_Click">
                <MenuItem.Icon>
                    <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Text="&#xE74D;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="WindowRoot" Background="Transparent">
        <Grid x:Name="MainSurface" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static local:Win10VisualMetrics.CollapsedNavigationGridLength}" />
                <ColumnDefinition Width="{x:Static local:Win10VisualMetrics.AllAppsGridLength}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="NavigationPane"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Width="{x:Static local:Win10VisualMetrics.CollapsedNavigationWidth}"
                  Margin="{x:Static local:Win10VisualMetrics.NavigationPaneMargin}"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  MouseEnter="NavigationPane_MouseEnter"
                  MouseLeave="NavigationPane_MouseLeave"
                  Panel.ZIndex="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{x:Static local:Win10VisualMetrics.NavigationItemGridLength}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="NavigationBackdrop"
                        Grid.RowSpan="3"
                        Margin="{x:Static local:Win10VisualMetrics.NavigationBackdropMargin}"
                        Background="{DynamicResource TileStartNavigationOverlayBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="{x:Static local:Win10VisualMetrics.NavigationShadowBlurRadius}"
                                          Color="#FF000000"
                                          Direction="{x:Static local:Win10VisualMetrics.NavigationShadowDirection}"
                                          Opacity="{x:Static local:Win10VisualMetrics.NavigationShadowOpacity}"
                                          ShadowDepth="{x:Static local:Win10VisualMetrics.NavigationShadowDepth}" />
                    </Border.Effect>
                </Border>
                <Button x:Name="NavigationToggleButton"
                        Grid.Row="0"
                        Style="{StaticResource RailButtonStyle}"
                        Content="&#xE700;"
                        Tag="开始"
                        ToolTip="展开"
                        Click="NavigationToggleButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu
                                     Opened="NavigationPreferencesMenu_Opened">
                            <MenuItem Header="用户" Tag="ShowUser" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="文档" Tag="ShowDocuments" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="下载" Tag="ShowDownloads" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="图片" Tag="ShowPictures" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="音乐" Tag="ShowMusic" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="视频" Tag="ShowVideos" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="文件资源管理器" Tag="ShowFileExplorer" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="网络" Tag="ShowNetwork" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                            <MenuItem Header="设置" Tag="ShowSettings" IsCheckable="True"
                                      Click="NavigationPreference_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel Grid.Row="2">
                    <Button x:Name="UserNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="{Binding CurrentUserName}"
                            ToolTip="用户"
                            Click="UserNavigationButton_Click">
                        <Button.Content>
                            <Grid x:Name="UserPictureVisual"
                                  Width="{x:Static local:Win10VisualMetrics.NavigationUserPictureSize}"
                                  Height="{x:Static local:Win10VisualMetrics.NavigationUserPictureSize}">
                                <Ellipse Fill="#5A5A5A" />
                                <TextBlock HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="{x:Static local:Win10VisualMetrics.NavigationGlyphFontSize}"
                                            Text="&#xE77B;" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding CurrentUserPicture}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu
                                         Opened="StartContextMenu_Opened"
                                         Closed="StartContextMenu_Closed">
                                <MenuItem Header="更改账户设置"
                                          Click="AccountSettings_Click" />
                                <MenuItem Header="锁定"
                                          Click="LockSession_Click" />
                                <MenuItem Header="注销" Click="SignOut_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="DocumentsNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE8A5;"
                            Tag="文档"
                            ToolTip="文档"
                            Click="DocumentsNavigationButton_Click" />
                    <Button x:Name="DownloadsNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE896;"
                            Tag="下载"
                            ToolTip="下载"
                            Click="DownloadsNavigationButton_Click" />
                    <Button x:Name="PicturesNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xEB9F;"
                            Tag="图片"
                            ToolTip="图片"
                            Click="PicturesNavigationButton_Click" />
                    <Button x:Name="MusicNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE8D6;"
                            Tag="音乐"
                            ToolTip="音乐"
                            Click="MusicNavigationButton_Click" />
                    <Button x:Name="VideosNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE714;"
                            Tag="视频"
                            ToolTip="视频"
                            Click="VideosNavigationButton_Click" />
                    <Button x:Name="FileExplorerNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE838;"
                            Tag="文件资源管理器"
                            ToolTip="文件资源管理器"
                            Click="FileExplorerNavigationButton_Click" />
                    <Button x:Name="NetworkNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE968;"
                            Tag="网络"
                            ToolTip="网络"
                            Click="NetworkNavigationButton_Click" />
                    <Button x:Name="SettingsNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Content="&#xE713;"
                            Tag="设置"
                            ToolTip="设置"
                            Click="SettingsNavigationButton_Click" />
                    <Button x:Name="PowerNavigationButton"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="电源"
                            ToolTip="电源"
                            Click="PowerNavigationButton_Click">
                        <Button.Content>
                            <Grid Width="48" Height="48">
                                <TextBlock HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="{x:Static local:Win10VisualMetrics.NavigationGlyphFontSize}"
                                            Text="&#xE7E8;" />
                                <Ellipse x:Name="PowerUpdateBadge"
                                         Width="6"
                                         Height="6"
                                         Margin="0,9,9,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource TileStartWarningBrush}"
                                         IsHitTestVisible="False"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu
                                         Opened="StartContextMenu_Opened"
                                         Closed="StartContextMenu_Closed">
                                <MenuItem Header="睡眠" Click="Sleep_Click" />
                                <MenuItem x:Name="UpdateAndShutDownMenuItem"
                                          Header="更新并关机"
                                          Visibility="Collapsed"
                                          Click="UpdateAndShutDown_Click" />
                                <MenuItem Header="关机"
                                          Click="ShutDown_Click" />
                                <MenuItem x:Name="UpdateAndRestartMenuItem"
                                          Header="更新并重启"
                                          Visibility="Collapsed"
                                          Click="UpdateAndRestart_Click" />
                                <MenuItem Header="重启" Click="Restart_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="SearchPanel"
                        Margin="8,8,8,4"
                        Height="36"
                        Background="{StaticResource TileStartControlBackgroundBrush}"
                        BorderBrush="{StaticResource TileStartControlStrokeHoverBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TileStartControlCornerRadius}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE721;" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Padding="0,7,4,0"
                                 Foreground="{StaticResource TileStartTextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="{StaticResource TileStartContentFont}"
                                 FontSize="14"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
                <Grid x:Name="SemanticZoomViewport"
                      Grid.Row="1"
                      ClipToBounds="True">
                    <Grid x:Name="SemanticZoomSurface">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SemanticZoomSharedScale"
                                                ScaleX="2"
                                                ScaleY="2" />
                                <TranslateTransform x:Name="SemanticZoomSharedTranslate" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid x:Name="ZoomedInPresenter">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SemanticZoomedInScale"
                                                    ScaleX="0.5"
                                                    ScaleY="0.5" />
                                    <TranslateTransform x:Name="SemanticZoomedInTranslate" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <ListBox x:Name="AppsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                     ItemsSource="{Binding AppsView}"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.PanningMode="VerticalOnly"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.CacheLength="1"
                                     VirtualizingPanel.CacheLengthUnit="Page"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     utilities:SmoothScroll.IsEnabled="True">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar"
                                           BasedOn="{StaticResource StartVerticalScrollBarStyle}" />
                                    <DataTemplate DataType="{x:Type apps:RecentApplicationsSection}">
                                        <StackPanel>
                                            <Border
                                                Height="{x:Static local:Win10VisualMetrics.AllAppsGroupHeaderHeight}"
                                                Margin="{x:Static local:Win10VisualMetrics.AllAppsItemMargin}"
                                                Background="Transparent">
                                                <TextBlock x:Name="RecentApplicationsHeader"
                                                           Margin="{x:Static local:Win10VisualMetrics.AllAppsGroupHeaderPadding}"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="{x:Static local:Win10VisualMetrics.AllAppsGroupHeaderFontSize}"
                                                           Text="最近添加" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Apps}"
                                                          ItemTemplate="{StaticResource AppEntryTemplate}" />
                                            <Button HorizontalContentAlignment="Left"
                                                    Click="RecentExpandButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource AppRowStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Text="{Binding ExpandText}" />
                                                     <TextBlock Margin="4,0"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="{x:Static local:Win10VisualMetrics.AllAppsExpandCollapseCaretFontSize}"
                                                                Text="{Binding ExpandGlyph}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type apps:AppEntry}">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource AppEntryTemplate}" />
                                    </DataTemplate>
                                </ListBox.Resources>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- StartUI 把 7 DIP 顶部和 54 DIP 底部留白放在滚动内容内部；
                                             不能放到 ListBox 外层，否则会缩短可视区域。 -->
                                        <VirtualizingStackPanel
                                            Margin="{x:Static local:Win10VisualMetrics.AllAppsListPadding}" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TileStartTextPrimaryBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding Name}"
                                                        Content="{Binding Name}"
                                                        Click="LetterHeader_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource LetterHeaderStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}"
                                                                             Value="{x:Static apps:RecentApplicationsSection.GroupKey}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </Grid>
                        <Border x:Name="LetterIndexPanel"
                                Panel.ZIndex="5"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Visibility="Collapsed">
                            <ItemsControl Width="208"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AlphabetLetters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="208" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type apps:AlphabetIndexEntry}">
                                        <Button Style="{StaticResource AlphabetButtonStyle}"
                                                Tag="{Binding}"
                                                Content="{Binding Label}"
                                                IsEnabled="{Binding IsAvailable}"
                                                Click="AlphabetLetter_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Border x:Name="TilePane"
                    Grid.Column="2"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="TileArea_DragOver"
                    Drop="TileArea_Drop">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建自定义磁贴…"
                                  Click="AddCommandTile_Click" />
                        <MenuItem Header="新建文件夹…"
                                  Click="AddFolder_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <ScrollViewer x:Name="TileScrollViewer"
                              Margin="{x:Static local:Win10VisualMetrics.TileScrollViewerMargin}"
                              PanningMode="VerticalOnly"
                              utilities:SmoothScroll.IsEnabled="True"
                              Style="{StaticResource TileScrollViewerStyle}">
                    <ItemsControl x:Name="TileGroupsControl"
                                  Margin="0,0,0,20"
                                  HorizontalAlignment="Center"
                                  ItemsSource="{Binding TileLayout.Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <layouts:Win10GroupWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TileGroup}">
                                <StackPanel Width="{Binding VisualWidth}"
                                            Margin="0,0,0,24">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="TileStart 组设置…"
                                                      Click="GroupSettings_Click" />
                                            <Separator />
                                            <MenuItem Header="删除组"
                                                      Click="DeleteGroup_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <layouts:TileGroupHeader
                                        Margin="{x:Static local:Win10VisualMetrics.TileGroupHeaderMargin}"
                                        NameCommitted="GroupHeader_NameCommitted"
                                        PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="GroupHeader_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="GroupHeader_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="GroupHeader_LostMouseCapture">
                                        <layouts:TileGroupHeader.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="TileStart 组设置…"
                                                          Click="GroupSettings_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16"
                                                                   Text="&#xE713;" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="从“开始”屏幕取消固定组"
                                                          Click="DeleteGroup_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16"
                                                                   Text="&#xE77A;" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </layouts:TileGroupHeader.ContextMenu>
                                    </layouts:TileGroupHeader>
                                    <Canvas Width="{Binding PixelWidth}"
                                            Height="{Binding PixelHeight}"
                                            HorizontalAlignment="Center"
                                            Margin="{x:Static local:Win10VisualMetrics.TileGroupTilesMargin}">
                                        <ItemsControl Width="{Binding PixelWidth}"
                                                      Height="{Binding PixelHeight}"
                                                      AllowDrop="True"
                                                      ItemsSource="{Binding Tiles}"
                                                      Tag="{Binding}"
                                                      DragOver="TileGroup_DragOver"
                                                      Drop="TileGroup_Drop">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding DisplayTop}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TileItem}">
                                                    <Button x:Name="TileButton"
                                                            Width="{Binding PixelWidth}"
                                                            Height="{Binding PixelHeight}"
                                                            Background="{Binding BackgroundBrush}"
                                                            Foreground="{Binding ForegroundBrush}"
                                                            Style="{StaticResource TileStyle}"
                                                            Tag="{Binding}"
                                                            ContextMenu="{StaticResource TileContextMenu}"
                                                            Click="TileButton_Click"
                                                            PreviewMouseLeftButtonDown="TileButton_PreviewMouseLeftButtonDown">

                                                        <Grid ClipToBounds="True">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition />
                                                                <RowDefinition
                                                                    Height="{x:Static local:Win10VisualMetrics.TileReservedBrandingGridLength}" />
                                                            </Grid.RowDefinitions>
                                                            <Image Grid.RowSpan="2"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   RenderTransformOrigin="0.5,0.5"
                                                                   Stretch="UniformToFill">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform
                                                                        ScaleX="{Binding BackgroundImageScale}"
                                                                        ScaleY="{Binding BackgroundImageScale}" />
                                                                </Image.RenderTransform>
                                                                <Image.Source>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource NonGifImageSourceConverter}">
                                                                        <Binding Path="BackgroundImage" />
                                                                        <Binding Path="BackgroundImagePath" />
                                                                    </MultiBinding>
                                                                </Image.Source>
                                                            </Image>
                                                            <Image Grid.RowSpan="2"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   gif:ImageBehavior.AnimatedSource="{Binding BackgroundImagePath, Converter={StaticResource GifImageSourceConverter}}"
                                                                   gif:ImageBehavior.RepeatBehavior="Forever"
                                                                   RenderTransformOrigin="0.5,0.5"
                                                                   Stretch="UniformToFill">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform
                                                                        ScaleX="{Binding BackgroundImageScale}"
                                                                        ScaleY="{Binding BackgroundImageScale}" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                            <TextBlock x:Name="TileInitial"
                                                                       Grid.Row="0"
                                                                       Grid.RowSpan="2"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="24"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Initial}"
                                                                       Visibility="Collapsed" />
                                                            <Image x:Name="TileIcon"
                                                                   Grid.Row="0"
                                                                   Grid.RowSpan="2"
                                                                   Width="{Binding IconSize}"
                                                                   Height="{Binding IconSize}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Stretch="Uniform">
                                                                <Image.Source>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource NonGifImageSourceConverter}">
                                                                        <Binding Path="Icon" />
                                                                        <Binding Path="IconPath" />
                                                                    </MultiBinding>
                                                                </Image.Source>
                                                                <Image.RenderTransform>
                                                                    <TranslateTransform
                                                                        Y="{x:Static local:Win10VisualMetrics.TileLogoVerticalOffset}" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                            <Image x:Name="TileAnimatedIcon"
                                                                   Grid.Row="0"
                                                                   Grid.RowSpan="2"
                                                                   Width="{Binding IconSize}"
                                                                   Height="{Binding IconSize}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   gif:ImageBehavior.AnimatedSource="{Binding IconPath, Converter={StaticResource GifImageSourceConverter}}"
                                                                   gif:ImageBehavior.RepeatBehavior="Forever"
                                                                   Stretch="Uniform">
                                                                <Image.RenderTransform>
                                                                    <TranslateTransform
                                                                        Y="{x:Static local:Win10VisualMetrics.TileLogoVerticalOffset}" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                              <Grid x:Name="FolderVisual"
                                                                    Grid.Row="0"
                                                                    Grid.RowSpan="2"
                                                                    Visibility="Collapsed">
                                                                 <!-- 预览仍遵循 Win10 的三列图标槽位；TileStart 按产品选择保留普通磁贴品牌区，
                                                                      让文件夹名称与其他磁贴一致显示，而不是复制原版的展开名称行。 -->
                                                                  <ItemsControl x:Name="FolderPreview"
                                                                                Width="{Binding PixelWidth}"
                                                                                Height="{Binding PixelHeight}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               ClipToBounds="True"
                                                                               ItemsSource="{Binding FolderPreviewTiles}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="3" Columns="3" />
                                                                        </ItemsPanelTemplate>
                                                                     </ItemsControl.ItemsPanel>
                                                                     <ItemsControl.ItemTemplate>
                                                                         <DataTemplate>
                                                                             <Grid Margin="2">
                                                                                     <Image
                                                                                         RenderOptions.BitmapScalingMode="HighQuality"
                                                                                         Stretch="Uniform">
                                                                                        <Image.Source>
                                                                                            <MultiBinding
                                                                                                Converter="{StaticResource NonGifImageSourceConverter}">
                                                                                                <Binding Path="Icon" />
                                                                                                <Binding Path="IconPath" />
                                                                                            </MultiBinding>
                                                                                        </Image.Source>
                                                                                    </Image>
                                                                                    <Image
                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                        gif:ImageBehavior.AnimatedSource="{Binding IconPath, Converter={StaticResource GifImageSourceConverter}}"
                                                                                         gif:ImageBehavior.RepeatBehavior="Forever"
                                                                                         Stretch="Uniform" />
                                                                             </Grid>
                                                                         </DataTemplate>
                                                                     </ItemsControl.ItemTemplate>
                                                                 </ItemsControl>
                                                                  <Grid x:Name="FolderCollapseGlyph"
                                                                        Visibility="Collapsed">
                                                                     <TextBlock HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                                FontSize="16"
                                                                                Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                                                               Text="&#xE70E;" />
                                                                </Grid>
                                                            </Grid>
                                                              <Grid x:Name="TileBranding"
                                                                    Style="{StaticResource TileStartTileTitleContainerStyle}">
                                                                 <TextBlock x:Name="TileTitle"
                                                                            FontFamily="{StaticResource TileStartContentFont}"
                                                                            FontSize="12"
                                                                            FontWeight="Normal"
                                                                            Style="{StaticResource TileStartTileTitleTextStyle}"
                                                                            Text="{Binding Name}"
                                                                           TextAlignment="Left"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                            </Grid>
                                                            <Grid x:Name="FolderDropCue"
                                                                  Grid.Row="0"
                                                                  Grid.RowSpan="2"
                                                                  Background="#52000000"
                                                                  IsHitTestVisible="False"
                                                                  Visibility="Collapsed">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="24"
                                                                           Foreground="{DynamicResource TileStartTextPrimaryBrush}"
                                                                           Text="&#xE8B7;" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter TargetName="TileInitial" Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                              <DataTrigger Binding="{Binding IsTileFolder}" Value="True">
                                                            <Setter TargetName="TileInitial" Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter TargetName="TileIcon" Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter TargetName="TileAnimatedIcon" Property="Visibility"
                                                                    Value="Collapsed" />
                                                                  <Setter TargetName="FolderVisual" Property="Visibility"
                                                                          Value="Visible" />
                                                              </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsFolderExpanded}" Value="True">
                                                             <Setter TargetName="FolderPreview" Property="Visibility"
                                                                     Value="Collapsed" />
                                                             <Setter TargetName="FolderCollapseGlyph" Property="Visibility"
                                                                     Value="Visible" />
                                                         </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                            <Setter TargetName="TileButton" Property="Opacity"
                                                                    Value="{x:Static local:Win10VisualMetrics.TileDraggingOpacity}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFolderDropTarget}"
                                                                     Value="True">
                                                            <Setter TargetName="FolderDropCue" Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Size}" Value="Small">
                                                            <Setter TargetName="TileBranding" Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowTitle}" Value="False">
                                                            <Setter TargetName="TileTitle" Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsesFullTileLogo}" Value="True">
                                                            <Setter TargetName="TileIcon" Property="Width" Value="Auto" />
                                                            <Setter TargetName="TileIcon" Property="Height"
                                                                    Value="Auto" />
                                                            <Setter TargetName="TileIcon" Property="Margin" Value="0" />
                                                            <Setter TargetName="TileIcon" Property="Stretch"
                                                                    Value="Fill" />
                                                            <Setter TargetName="TileIcon" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconPosition}" Value="TopLeft">
                                                            <Setter TargetName="TileIcon"
                                                                    Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="TileIcon" Property="VerticalAlignment"
                                                                    Value="Top" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="VerticalAlignment"
                                                                    Value="Top" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconPosition}" Value="TopRight">
                                                            <Setter TargetName="TileIcon"
                                                                    Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="TileIcon" Property="VerticalAlignment"
                                                                    Value="Top" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="VerticalAlignment"
                                                                    Value="Top" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconPosition}"
                                                                     Value="BottomLeft">
                                                            <Setter TargetName="TileIcon"
                                                                    Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="TileIcon" Property="VerticalAlignment"
                                                                    Value="Bottom" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="HorizontalAlignment" Value="Left" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="VerticalAlignment"
                                                                    Value="Bottom" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconPosition}"
                                                                     Value="BottomRight">
                                                            <Setter TargetName="TileIcon"
                                                                    Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="TileIcon" Property="VerticalAlignment"
                                                                    Value="Bottom" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="HorizontalAlignment" Value="Right" />
                                                            <Setter TargetName="TileAnimatedIcon"
                                                                    Property="VerticalAlignment"
                                                                    Value="Bottom" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Width="{x:Static local:Win10TileMetrics.GroupWidth}"
                                                      Height="{Binding PixelHeight}"
                                                      Panel.ZIndex="2"
                                                      ItemsSource="{Binding Tiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="0" />
                                                    <Setter Property="Canvas.Top" Value="{Binding FolderRegionTop}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TileItem}">
                                                      <Border x:Name="FolderRegion"
                                                              Width="{x:Static local:Win10TileMetrics.GroupWidth}"
                                                              Height="{Binding FolderRegionHeight}"
                                                              Background="Transparent"
                                                              ClipToBounds="True">
                                                          <Grid>
                                                              <Grid.RowDefinitions>
                                                                  <RowDefinition Height="*" />
                                                                  <RowDefinition Height="4" />
                                                              </Grid.RowDefinitions>
                                                              <!-- 名称由上方文件夹磁贴的普通品牌区显示；透明内联区域只承载子磁贴，
                                                                   因此既不会出现重复标题，也不会被误解成嵌套组。 -->
                                                             <ItemsControl Grid.Row="0"
                                                                           Width="{x:Static local:Win10TileMetrics.GroupWidth}"
                                                                           Height="{Binding FolderContentHeight}"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Top"
                                                                          AllowDrop="True"
                                                                          ItemsSource="{Binding FolderTiles}"
                                                                          Tag="{Binding}"
                                                                          DragOver="FolderRegion_DragOver"
                                                                          Drop="FolderRegion_Drop">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left"
                                                                                Value="{Binding Left}" />
                                                                        <Setter Property="Canvas.Top"
                                                                                Value="{Binding Top}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                 <ItemsControl.ItemTemplate>
                                                                     <DataTemplate DataType="{x:Type models:TileItem}">
                                                                         <Button Width="{Binding PixelWidth}"
                                                                                Height="{Binding PixelHeight}"
                                                                                Background="{Binding BackgroundBrush}"
                                                                                Foreground="{Binding ForegroundBrush}"
                                                                                Style="{StaticResource TileStyle}"
                                                                                Tag="{Binding}"
                                                                                 ContextMenu="{StaticResource TileContextMenu}"
                                                                                 Click="TileButton_Click"
                                                                                 PreviewMouseLeftButtonDown="TileButton_PreviewMouseLeftButtonDown">
                                                                             <Grid ClipToBounds="True">
                                                                                 <Grid.RowDefinitions>
                                                                                     <RowDefinition />
                                                                                     <RowDefinition
                                                                                         Height="{x:Static local:Win10VisualMetrics.TileReservedBrandingGridLength}" />
                                                                                 </Grid.RowDefinitions>
                                                                                 <Image Grid.RowSpan="2"
                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                        RenderTransformOrigin="0.5,0.5"
                                                                                        Stretch="UniformToFill">
                                                                                     <Image.RenderTransform>
                                                                                         <ScaleTransform
                                                                                             ScaleX="{Binding BackgroundImageScale}"
                                                                                             ScaleY="{Binding BackgroundImageScale}" />
                                                                                     </Image.RenderTransform>
                                                                                     <Image.Source>
                                                                                         <MultiBinding
                                                                                             Converter="{StaticResource NonGifImageSourceConverter}">
                                                                                             <Binding Path="BackgroundImage" />
                                                                                             <Binding Path="BackgroundImagePath" />
                                                                                         </MultiBinding>
                                                                                     </Image.Source>
                                                                                 </Image>
                                                                                 <Image Grid.RowSpan="2"
                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                        gif:ImageBehavior.AnimatedSource="{Binding BackgroundImagePath, Converter={StaticResource GifImageSourceConverter}}"
                                                                                        gif:ImageBehavior.RepeatBehavior="Forever"
                                                                                        RenderTransformOrigin="0.5,0.5"
                                                                                        Stretch="UniformToFill">
                                                                                     <Image.RenderTransform>
                                                                                         <ScaleTransform
                                                                                             ScaleX="{Binding BackgroundImageScale}"
                                                                                             ScaleY="{Binding BackgroundImageScale}" />
                                                                                     </Image.RenderTransform>
                                                                                 </Image>
                                                                                 <TextBlock x:Name="FolderChildInitial"
                                                                                            Grid.RowSpan="2"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                            FontSize="24"
                                                                                            FontWeight="SemiBold"
                                                                                            Text="{Binding Initial}"
                                                                                            Visibility="Collapsed" />
                                                                                 <Image x:Name="FolderChildIcon"
                                                                                        Grid.RowSpan="2"
                                                                                        Width="{Binding IconSize}"
                                                                                        Height="{Binding IconSize}"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                        Stretch="Uniform">
                                                                                     <Image.Source>
                                                                                         <MultiBinding
                                                                                             Converter="{StaticResource NonGifImageSourceConverter}">
                                                                                             <Binding Path="Icon" />
                                                                                             <Binding Path="IconPath" />
                                                                                         </MultiBinding>
                                                                                     </Image.Source>
                                                                                     <Image.RenderTransform>
                                                                                         <TranslateTransform
                                                                                             Y="{x:Static local:Win10VisualMetrics.TileLogoVerticalOffset}" />
                                                                                     </Image.RenderTransform>
                                                                                 </Image>
                                                                                 <Image x:Name="FolderChildAnimatedIcon"
                                                                                        Grid.RowSpan="2"
                                                                                        Width="{Binding IconSize}"
                                                                                        Height="{Binding IconSize}"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                        gif:ImageBehavior.AnimatedSource="{Binding IconPath, Converter={StaticResource GifImageSourceConverter}}"
                                                                                        gif:ImageBehavior.RepeatBehavior="Forever"
                                                                                        Stretch="Uniform">
                                                                                     <Image.RenderTransform>
                                                                                         <TranslateTransform
                                                                                             Y="{x:Static local:Win10VisualMetrics.TileLogoVerticalOffset}" />
                                                                                     </Image.RenderTransform>
                                                                                 </Image>
                                                                                  <Grid x:Name="FolderChildBranding"
                                                                                        Style="{StaticResource TileStartTileTitleContainerStyle}">
                                                                                      <TextBlock x:Name="FolderChildTitle"
                                                                                                 FontFamily="{StaticResource TileStartContentFont}"
                                                                                                 FontSize="12"
                                                                                                 FontWeight="Normal"
                                                                                                 Style="{StaticResource TileStartTileTitleTextStyle}"
                                                                                                 Text="{Binding Name}"
                                                                                                TextTrimming="CharacterEllipsis"
                                                                                                TextWrapping="NoWrap" />
                                                                                 </Grid>
                                                                             </Grid>
                                                                         </Button>
                                                                         <DataTemplate.Triggers>
                                                                             <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                 <Setter TargetName="FolderChildInitial"
                                                                                         Property="Visibility"
                                                                                         Value="Visible" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding Size}" Value="Small">
                                                                                 <Setter TargetName="FolderChildBranding"
                                                                                         Property="Visibility"
                                                                                         Value="Collapsed" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding ShowTitle}" Value="False">
                                                                                 <Setter TargetName="FolderChildTitle"
                                                                                         Property="Visibility"
                                                                                         Value="Collapsed" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding UsesFullTileLogo}" Value="True">
                                                                                 <Setter TargetName="FolderChildIcon" Property="Width" Value="Auto" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="Height" Value="Auto" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="Margin" Value="0" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="Stretch" Value="Fill" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="RenderTransform">
                                                                                     <Setter.Value>
                                                                                         <TranslateTransform Y="0" />
                                                                                     </Setter.Value>
                                                                                 </Setter>
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding IconPosition}" Value="TopLeft">
                                                                                 <Setter TargetName="FolderChildIcon" Property="HorizontalAlignment" Value="Left" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="VerticalAlignment" Value="Top" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="HorizontalAlignment" Value="Left" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="VerticalAlignment" Value="Top" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding IconPosition}" Value="TopRight">
                                                                                 <Setter TargetName="FolderChildIcon" Property="HorizontalAlignment" Value="Right" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="VerticalAlignment" Value="Top" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="HorizontalAlignment" Value="Right" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="VerticalAlignment" Value="Top" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding IconPosition}" Value="BottomLeft">
                                                                                 <Setter TargetName="FolderChildIcon" Property="HorizontalAlignment" Value="Left" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="VerticalAlignment" Value="Bottom" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="HorizontalAlignment" Value="Left" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="VerticalAlignment" Value="Bottom" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding IconPosition}" Value="BottomRight">
                                                                                 <Setter TargetName="FolderChildIcon" Property="HorizontalAlignment" Value="Right" />
                                                                                 <Setter TargetName="FolderChildIcon" Property="VerticalAlignment" Value="Bottom" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="HorizontalAlignment" Value="Right" />
                                                                                 <Setter TargetName="FolderChildAnimatedIcon" Property="VerticalAlignment" Value="Bottom" />
                                                                             </DataTrigger>
                                                                         </DataTemplate.Triggers>
                                                                     </DataTemplate>
                                                                 </ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                         </Grid>
                                                     </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolderExpanded}" Value="False">
                                                            <Setter TargetName="FolderRegion" Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Canvas x:Name="InternalDragOverlay"
                    Grid.ColumnSpan="3"
                    IsHitTestVisible="False"
                    Panel.ZIndex="20">
                <Image x:Name="InternalDragPreview"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Opacity="0.96"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"
                       Visibility="Collapsed">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="InternalDragPreviewScaleTransform" />
                            <TranslateTransform x:Name="InternalDragPreviewTransform" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
            <Border Height="7"
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Cursor="SizeNS"
                    Panel.ZIndex="50"
                    MouseLeftButtonDown="TopResizeBorder_MouseLeftButtonDown" />
            <Border Width="7"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Cursor="SizeWE"
                    Panel.ZIndex="50"
                    MouseLeftButtonDown="RightResizeBorder_MouseLeftButtonDown" />
            <Border Width="14"
                    Height="14"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Cursor="SizeNESW"
                    Panel.ZIndex="51"
                    MouseLeftButtonDown="TopRightResizeBorder_MouseLeftButtonDown" />
        </Grid>
    </Grid>
</Window>
