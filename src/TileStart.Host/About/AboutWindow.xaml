<Window x:Class="TileStart.Host.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 TileStart"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Style="{StaticResource TileStartDialogWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                                   CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                                  GlassFrameThickness="0"
                                  ResizeBorderThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="AboutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TileStartButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style x:Key="PrimaryAboutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TileStartPrimaryButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource TileStartDialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource TileStartLayerBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE946;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="关于 TileStart" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource TileStartTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="30,26,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88"
                             Height="88"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                             Style="{StaticResource TileStartCardStyle}">
                        <Image Width="72"
                               Height="72"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/TileStart.Host;component/Assets/TileStart-icon-master.png"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="27" FontWeight="SemiBold" Text="TileStart" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock x:Name="VersionText"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TileStartTextSecondaryBrush}" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,3"
                                    Background="{StaticResource TileStartControlBackgroundBrush}"
                                    BorderBrush="{StaticResource TileStartControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource TileStartControlCornerRadius}">
                                <TextBlock x:Name="EditionText" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource TileStartTextSecondaryBrush}"
                                   Text="为 Windows 10 与 Windows 11 重建熟悉的磁贴开始菜单。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                         Margin="0,24,0,0"
                         Padding="18,15"
                         Style="{StaticResource TileStartCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{StaticResource TileStartTextSecondaryBrush}" Text="支持系统" />
                        <TextBlock Grid.Column="1" Text="Windows 10 / Windows 11 · x64" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{StaticResource TileStartTextSecondaryBrush}"
                                   Text="项目作者" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Narylr350" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,11"
                    Background="{StaticResource TileStartLayerBackgroundBrush}"
                    BorderBrush="{StaticResource TileStartDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource AboutButtonStyle}"
                            Click="CheckUpdates_Click"
                            Content="检查更新" />
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource PrimaryAboutButtonStyle}"
                            Click="OpenProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE774;" />
                            <TextBlock VerticalAlignment="Center" Text="GitHub 项目" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AboutButtonStyle}"
                            IsCancel="True"
                            Content="返回设置" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
