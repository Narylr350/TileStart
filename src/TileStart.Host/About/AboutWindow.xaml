<Window x:Class="TileStart.Host.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 TileStart"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#1F1F1F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                                  CornerRadius="0"
                                  GlassFrameThickness="0"
                                  ResizeBorderThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#B8B8B8" />
        <Style x:Key="AboutCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBackground" Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBackground" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#343434" />
            <Setter Property="BorderBrush" Value="#606060" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryAboutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AboutButtonStyle}">
            <Setter Property="Background" Value="#D23888" />
            <Setter Property="BorderBrush" Value="#D23888" />
        </Style>
    </Window.Resources>

    <Border Background="#1F1F1F" BorderBrush="#454545" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Background="#252525" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE946;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="关于 TileStart" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource AboutCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsCancel="True"
                        Content="&#xE8BB;" />
            </Grid>

            <Grid Grid.Row="1" Margin="30,26,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="88"
                            Height="88"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#292929"
                            BorderBrush="#444444"
                            BorderThickness="1">
                        <Image Width="72"
                               Height="72"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/TileStart.Host;component/Assets/TileStart-icon-master.png"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="27" FontWeight="SemiBold" Text="TileStart" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock x:Name="VersionText"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedText}" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,3"
                                    Background="#333333"
                                    BorderBrush="#555555"
                                    BorderThickness="1">
                                <TextBlock x:Name="EditionText" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedText}"
                                   Text="为 Windows 10 与 Windows 11 重建熟悉的磁贴开始菜单。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,24,0,0"
                        Padding="18,15"
                        Background="#262626"
                        BorderBrush="#404040"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{StaticResource MutedText}" Text="支持系统" />
                        <TextBlock Grid.Column="1" Text="Windows 10 / Windows 11 · x64" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{StaticResource MutedText}"
                                   Text="项目作者" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Narylr350" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,11"
                    Background="#252525"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource PrimaryAboutButtonStyle}"
                            Click="OpenProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE774;" />
                            <TextBlock VerticalAlignment="Center" Text="GitHub 项目" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AboutButtonStyle}"
                            IsCancel="True"
                            Content="关闭" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
