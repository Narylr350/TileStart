<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TileStart.Host;component/Themes/Win11Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="TileStartContentFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TileStartDisplayFont">Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="TileStartTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartTextSecondaryBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="TileStartTextTertiaryBrush" Color="#A8FFFFFF" />
    <SolidColorBrush x:Key="TileStartTextDisabledBrush" Color="#61FFFFFF" />
    <SolidColorBrush x:Key="TileStartWindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TileStartLayerBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="TileStartLayerAltBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="TileStartCardBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="TileStartControlBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TileStartControlHoverBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="TileStartControlPressedBrush" Color="#484848" />
    <SolidColorBrush x:Key="TileStartControlStrokeBrush" Color="#686868" />
    <SolidColorBrush x:Key="TileStartControlStrokeHoverBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TileStartDividerBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TileStartWindowStrokeBrush" Color="#454545" />
    <SolidColorBrush x:Key="TileStartPopupBackgroundBrush" Color="#FC232323" />
    <SolidColorBrush x:Key="TileStartPopupStrokeBrush" Color="#171717" />
    <SolidColorBrush x:Key="TileStartContextMenuHighlightBrush"
                     Color="{x:Static local:Win10Theme.AccentColor}" />
    <SolidColorBrush x:Key="TileStartSubtleFillBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillHoverBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillPressedBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartNavigationOverlayBrush" Color="#EE202020" />
    <SolidColorBrush x:Key="TileStartSuccessBrush" Color="#69C56D" />
    <SolidColorBrush x:Key="TileStartWarningBrush" Color="#FFFFB900" />
    <SolidColorBrush x:Key="TileStartErrorBrush" Color="#FF8C8C" />

    <CornerRadius x:Key="TileStartControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartOverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartTileCornerRadius">0</CornerRadius>
    <Thickness x:Key="TileStartContextMenuPresenterPadding">0,4,0,4</Thickness>
</ResourceDictionary>