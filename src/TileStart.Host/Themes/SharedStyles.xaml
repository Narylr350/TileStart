<ResourceDictionary x:Class="TileStart.Host.Themes.SharedStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host"
                    xmlns:utilities="clr-namespace:TileStart.Host.Utilities">
    <Style x:Key="TileStartDialogWindowStyle" TargetType="Window">
        <EventSetter Event="Loaded" Handler="DialogWindow_Loaded" />
        <Setter Property="Background" Value="{DynamicResource TileStartWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource TileStartContentFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- 标题容器和文字样式同时用于主磁贴、文件夹内容与设置预览。
         BottomLeft 是默认值，保证旧布局仍保持原来的 Win10 品牌区位置。 -->
    <Style x:Key="TileStartTileTitleContainerStyle" TargetType="Grid">
        <Setter Property="Grid.Row" Value="1" />
        <!-- 实际磁贴靠 Grid.Row=1 落在品牌区；设置预览没有两行网格，
             还必须保留显式的底部锚点，二者才能使用同一套位置样式。 -->
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.TileBrandingMargin}" />
        <Style.Triggers>
            <!-- FolderAppSpaceVisual uses 8,0,0,5 for its display name. -->
            <DataTrigger Binding="{Binding IsTileFolder}" Value="True">
                <Setter Property="Margin" Value="8,0,0,5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopLeft">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.TileTopBrandingMargin}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopCenter">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.TileTopBrandingMargin}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopRight">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.TileTopBrandingMargin}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartTileTitleTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <!-- Tile_DisplayNameText_Style is based on Win10 CaptionTextBlockStyle. -->
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TitlePosition}" Value="BottomCenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="BottomRight">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopLeft">
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopCenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
            <DataTrigger Binding="{Binding TitlePosition}" Value="TopRight">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartDialogSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TileStartWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartWindowStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileStartOverlayCornerRadius}" />
    </Style>

    <Style x:Key="TileStartCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TileStartCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileStartOverlayCornerRadius}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Placement" Value="Right" />
        <Setter Property="HorizontalOffset" Value="8" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TileStartControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource TileStartControlPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TileStartTextDisabledBrush}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TileStartButtonStyle}">
        <Setter Property="Foreground" Value="{x:Static local:Win10Theme.AccentForegroundBrush}" />
        <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush"
                                    Value="{DynamicResource TileStartControlStrokeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1,1,1,2" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder"
                                Width="18"
                                Height="18"
                                Background="{DynamicResource TileStartControlBackgroundBrush}"
                                BorderBrush="{DynamicResource TileStartControlStrokeHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock x:Name="CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{x:Static local:Win10Theme.AccentForegroundBrush}"
                                       Text="&#xE73E;"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource TileStartControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartDialogScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Margin" Value="0,2,2,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb"
                                       Width="2"
                                       MinHeight="24"
                                       HorizontalAlignment="Right"
                                       Background="{DynamicResource TileStartTextTertiaryBrush}"
                                       Opacity="0.72">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Width" Value="6" />
                            <Setter TargetName="ScrollThumb" Property="Opacity" Value="1" />
                            <Setter TargetName="ScrollThumb" Property="Background"
                                    Value="{DynamicResource TileStartTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartTitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseButtonBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseButtonBackground" Property="Background" Value="#C42B1C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseButtonBackground" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartDarkExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          Height="44"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid x:Name="HeaderBackground" Background="{TemplateBinding Background}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Margin="16,0,0,0"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                            <TextBlock x:Name="Chevron"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Text="&#xE70D;" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background"
                                                        Value="{DynamicResource TileStartSubtleFillHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Margin="16,2,16,16"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartPopupBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{x:Static local:Win10Theme.ContextMenuHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                            <Grid>
                                <ContentPresenter Margin="10,0,36,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <TextBlock Margin="0,0,12,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="9"
                                           Text="&#xE70D;" />
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="240"
                                Padding="0,4"
                                Background="{DynamicResource TileStartPopupBackgroundBrush}"
                                BorderBrush="{DynamicResource TileStartPopupStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource TileStartOverlayCornerRadius}">
                                <ScrollViewer CanContentScroll="False"
                                              PanningMode="VerticalOnly"
                                              utilities:SmoothScroll.IsEnabled="True">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush"
                                    Value="{DynamicResource TileStartControlStrokeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush"
                                    Value="{x:Static local:Win10Theme.ContextMenuHighlightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="MinWidth" Value="{x:Static local:Win10VisualMetrics.ContextMenuMinWidth}" />
        <Setter Property="Background" Value="{DynamicResource TileStartPopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartPopupStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource TileStartContextMenuPresenterPadding}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="ContextMenuPopupBorder"
                            MinWidth="{TemplateBinding MinWidth}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartOverlayCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{x:Static local:Win10VisualMetrics.ContextMenuItemPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource TileStartContentFont}" />
        <Setter Property="FontSize" Value="{x:Static local:Win10VisualMetrics.ContextMenuFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuItemRoot"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CheckColumn" Width="0" />
                                <ColumnDefinition
                                    Width="{x:Static local:Win10VisualMetrics.ContextMenuIconPlaceholderGridLength}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckMark"
                                       Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TileStartTextSecondaryBrush}"
                                       FontSize="{x:Static local:Win10VisualMetrics.ContextMenuCheckGlyphFontSize}"
                                       Text="{x:Static local:Win10VisualMetrics.ContextMenuCheckGlyph}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Icon}" />
                            <ContentPresenter Grid.Column="2"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            <TextBlock x:Name="SubmenuArrow"
                                       Grid.Column="3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TileStartTextSecondaryBrush}"
                                       FontSize="{x:Static local:Win10VisualMetrics.ContextMenuSubmenuArrowFontSize}"
                                       Text="{x:Static local:Win10VisualMetrics.ContextMenuSubmenuArrowGlyph}"
                                       Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Opened="SubmenuPopup_Opened"
                                   Closed="SubmenuPopup_Closed"
                                   Placement="Right"
                                   PopupAnimation="None">
                                <Border MinWidth="{x:Static local:Win10VisualMetrics.ContextMenuMinWidth}"
                                        Padding="{DynamicResource TileStartContextMenuPresenterPadding}"
                                        Background="{DynamicResource TileStartPopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource TileStartPopupStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource TileStartOverlayCornerRadius}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="CheckColumn"
                                    Property="Width"
                                    Value="{x:Static local:Win10VisualMetrics.ContextMenuCheckPlaceholderGridLength}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuItemRoot" Property="Background"
                                    Value="{DynamicResource TileStartContextMenuHighlightBrush}" />
                            <Setter TargetName="SubmenuArrow" Property="Foreground"
                                    Value="{DynamicResource TileStartTextPrimaryBrush}" />
                            <Setter TargetName="CheckMark" Property="Foreground"
                                    Value="{DynamicResource TileStartTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="MenuItemRoot" Property="Background"
                                    Value="{DynamicResource TileStartContextMenuHighlightBrush}" />
                            <Setter TargetName="SubmenuArrow" Property="Foreground"
                                    Value="{DynamicResource TileStartTextPrimaryBrush}" />
                            <Setter TargetName="CheckMark" Property="Foreground"
                                    Value="{DynamicResource TileStartTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{x:Static local:Win10VisualMetrics.ContextMenuDisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="{x:Static local:Win10VisualMetrics.ContextMenuSeparatorHeight}" />
        <Setter Property="Margin" Value="{x:Static local:Win10VisualMetrics.ContextMenuSeparatorMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{DynamicResource TileStartMenuSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource TileStartContextMenuStyle}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource TileStartMenuItemStyle}" />
    <Style TargetType="Separator" BasedOn="{StaticResource TileStartMenuSeparatorStyle}" />
</ResourceDictionary>