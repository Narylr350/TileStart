<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host">
    <FontFamily x:Key="TileStartContentFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TileStartDisplayFont">Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- Win10 19041 ThemeResources: SystemBaseHigh/MediumHigh/Medium/Low. -->
    <SolidColorBrush x:Key="TileStartTextPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TileStartTextSecondaryBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="TileStartTextTertiaryBrush" Color="#99000000" />
    <SolidColorBrush x:Key="TileStartTextDisabledBrush" Color="#33000000" />
    <SolidColorBrush x:Key="TileStartWindowBackgroundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TileStartLayerBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TileStartLayerAltBackgroundBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TileStartCardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartControlBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartControlHoverBrush" Color="#19000000" />
    <SolidColorBrush x:Key="TileStartControlPressedBrush" Color="#33000000" />
    <SolidColorBrush x:Key="TileStartControlStrokeBrush" Color="#66000000" />
    <SolidColorBrush x:Key="TileStartControlStrokeHoverBrush" Color="#99000000" />
    <SolidColorBrush x:Key="TileStartDividerBrush" Color="#19000000" />
    <SolidColorBrush x:Key="TileStartScrollBarThumbRestBrush" Color="#33000000" />
    <SolidColorBrush x:Key="TileStartScrollBarThumbHoverBrush" Color="#99000000" />
    <SolidColorBrush x:Key="TileStartMenuSeparatorBrush" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="TileStartWindowStrokeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="TileStartFocusSecondaryBrush" Color="#99FFFFFF" />
    <!-- AllAppsPane ListViewItemPresenter: AltHigh outer focus + BaseHigh inner focus. -->
    <SolidColorBrush x:Key="TileStartListFocusPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartListFocusSecondaryBrush" Color="#FF000000" />
    <!-- MenuFlyoutPresenter fallback and transient border from Win10 ThemeResources. -->
    <SolidColorBrush x:Key="TileStartPopupBackgroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TileStartPopupStrokeBrush" Color="#24000000" />
    <SolidColorBrush x:Key="TileStartContextMenuHighlightBrush"
                     Color="#19000000" />
    <SolidColorBrush x:Key="TileStartContextMenuSubmenuOpenedBrush"
                     Color="{x:Static local:Win10Theme.AccentColor}"
                     Opacity="0.4" />
    <SolidColorBrush x:Key="TileStartContextMenuPressedBrush"
                     Color="{x:Static local:Win10Theme.AccentColor}"
                     Opacity="0.7" />
    <SolidColorBrush x:Key="TileStartSubtleFillBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TileStartSubtleFillHoverBrush" Color="#19000000" />
    <SolidColorBrush x:Key="TileStartSubtleFillPressedBrush" Color="#33000000" />
    <!-- StartUI NavigationPaneAcrylicBackgroundBrush tint; composited over the main acrylic. -->
    <SolidColorBrush x:Key="TileStartNavigationOverlayBrush" Color="#80E9E9E9" />
    <!-- StartUI DefaultItem_BackgroundBrush resolves directly to SystemAccentColor. -->
    <SolidColorBrush x:Key="TileStartDefaultTileBackgroundBrush"
                     Color="{x:Static local:Win10Theme.AccentColor}" />
    <SolidColorBrush x:Key="TileStartSuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="TileStartWarningBrush" Color="#8A4F00" />
    <SolidColorBrush x:Key="TileStartErrorBrush" Color="#C42B1C" />

    <CornerRadius x:Key="TileStartControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartOverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartTileCornerRadius">0</CornerRadius>
    <Thickness x:Key="TileStartContextMenuPresenterPadding">0,4,0,4</Thickness>
</ResourceDictionary>
