<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host">
    <FontFamily x:Key="TileStartContentFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TileStartDisplayFont">Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="TileStartTextPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TileStartTextSecondaryBrush" Color="#A3000000" />
    <SolidColorBrush x:Key="TileStartTextTertiaryBrush" Color="#73000000" />
    <SolidColorBrush x:Key="TileStartTextDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="TileStartWindowBackgroundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TileStartLayerBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TileStartLayerAltBackgroundBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TileStartCardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartControlBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartControlHoverBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="TileStartControlPressedBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="TileStartControlStrokeBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TileStartControlStrokeHoverBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TileStartDividerBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="TileStartWindowStrokeBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TileStartPopupBackgroundBrush" Color="#FCFAFAFA" />
    <SolidColorBrush x:Key="TileStartPopupStrokeBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TileStartContextMenuHighlightBrush"
                     Color="{x:Static local:Win10Theme.AccentColor}" />
    <SolidColorBrush x:Key="TileStartSubtleFillBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="TileStartSubtleFillHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TileStartSubtleFillPressedBrush" Color="#1E000000" />
    <SolidColorBrush x:Key="TileStartNavigationOverlayBrush" Color="#EEF2F2F2" />
    <SolidColorBrush x:Key="TileStartDefaultTileBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TileStartSuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="TileStartWarningBrush" Color="#8A4F00" />
    <SolidColorBrush x:Key="TileStartErrorBrush" Color="#C42B1C" />

    <CornerRadius x:Key="TileStartControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartOverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileStartTileCornerRadius">0</CornerRadius>
    <Thickness x:Key="TileStartContextMenuPresenterPadding">0,4,0,4</Thickness>
</ResourceDictionary>
