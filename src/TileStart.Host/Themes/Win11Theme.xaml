<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host">
    <FontFamily x:Key="TileStartContentFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TileStartDisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="TileStartTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartTextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TileStartTextTertiaryBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="TileStartTextDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TileStartWindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="TileStartLayerBackgroundBrush" Color="#272727" />
    <SolidColorBrush x:Key="TileStartLayerAltBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TileStartCardBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="TileStartControlBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="TileStartControlHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="TileStartControlPressedBrush" Color="#323232" />
    <SolidColorBrush x:Key="TileStartControlStrokeBrush" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="TileStartControlStrokeHoverBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="TileStartDividerBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartScrollBarThumbRestBrush" Color="#64FFFFFF" />
    <SolidColorBrush x:Key="TileStartScrollBarThumbHoverBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TileStartMenuSeparatorBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartWindowStrokeBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="TileStartFocusSecondaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TileStartListFocusPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TileStartListFocusSecondaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartPopupBackgroundBrush" Color="#F92C2C2C" />
    <!-- StartDocked SystemControlAcrylicElementBrush tint: #242424 at 0.85. -->
    <SolidColorBrush x:Key="TileStartPopupAcrylicTintBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="TileStartPopupStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TileStartContextMenuHighlightBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileStartContextMenuSubmenuOpenedBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileStartContextMenuPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TileStartNavigationOverlayBrush"
                     Color="{x:Static local:Win10Theme.StartSurfaceOverlayColor}" />
    <!-- Win11 cards sit as a weak state layer over the live Acrylic instead of becoming an opaque tile. -->
    <SolidColorBrush x:Key="TileStartDefaultTileBackgroundBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TileStartTileBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TileStartSearchBackgroundBrush" Color="#73000000" />
    <SolidColorBrush x:Key="TileStartSearchStrokeBrush" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="TileStartSuccessBrush" Color="#6CCB7F" />
    <SolidColorBrush x:Key="TileStartWarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="TileStartErrorBrush" Color="#FF99A4" />

    <CornerRadius x:Key="TileStartControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="TileStartOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TileStartTileCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="TileStartSearchCornerRadius">18</CornerRadius>
    <Thickness x:Key="TileStartTileBorderThickness">0</Thickness>
    <Thickness x:Key="TileStartContextMenuPresenterPadding">4</Thickness>

    <Style x:Key="TileStartListInteractionStyle" TargetType="{x:Type local:Win10InteractionBorder}">
        <Setter Property="HoverFillOpacity" Value="0" />
        <Setter Property="PressedFillOpacity" Value="0" />
        <Setter Property="HoverFillBrush" Value="{StaticResource TileStartSubtleFillHoverBrush}" />
        <Setter Property="PressedFillBrush" Value="{StaticResource TileStartSubtleFillPressedBrush}" />
        <Setter Property="RevealBorderOpacity" Value="0" />
    </Style>
    <Style x:Key="TileStartTileInteractionStyle" TargetType="{x:Type local:Win10InteractionBorder}">
        <Setter Property="HoverFillOpacity" Value="0" />
        <Setter Property="PressedFillOpacity" Value="0" />
        <Setter Property="HoverFillBrush" Value="{StaticResource TileStartSubtleFillHoverBrush}" />
        <Setter Property="PressedFillBrush" Value="{StaticResource TileStartSubtleFillPressedBrush}" />
        <Setter Property="RevealBorderOpacity" Value="0" />
    </Style>
    <Style x:Key="TileStartTileRevealInteractionStyle" TargetType="{x:Type local:Win10InteractionBorder}">
        <Setter Property="HoverFillOpacity" Value="0" />
        <Setter Property="PressedFillOpacity" Value="0" />
        <Setter Property="RevealBorderOpacity" Value="0" />
    </Style>
</ResourceDictionary>
