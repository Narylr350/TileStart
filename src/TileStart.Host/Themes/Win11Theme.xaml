<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TileStart.Host">
    <FontFamily x:Key="TileStartContentFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TileStartDisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="TileStartTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TileStartTextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TileStartTextTertiaryBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="TileStartTextDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TileStartWindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="TileStartLayerBackgroundBrush" Color="#272727" />
    <SolidColorBrush x:Key="TileStartLayerAltBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TileStartCardBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="TileStartControlBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="TileStartControlHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="TileStartControlPressedBrush" Color="#323232" />
    <SolidColorBrush x:Key="TileStartControlStrokeBrush" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="TileStartControlStrokeHoverBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="TileStartDividerBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartWindowStrokeBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="TileStartPopupBackgroundBrush" Color="#F92C2C2C" />
    <SolidColorBrush x:Key="TileStartPopupStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TileStartContextMenuHighlightBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TileStartSubtleFillPressedBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="TileStartNavigationOverlayBrush" Color="#F22C2C2C" />
    <SolidColorBrush x:Key="TileStartSuccessBrush" Color="#6CCB7F" />
    <SolidColorBrush x:Key="TileStartWarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="TileStartErrorBrush" Color="#FF99A4" />

    <CornerRadius x:Key="TileStartControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="TileStartOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TileStartTileCornerRadius">0</CornerRadius>
    <Thickness x:Key="TileStartContextMenuPresenterPadding">4</Thickness>

    <Style x:Key="TileStartDialogWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource TileStartWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource TileStartContentFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="TileStartDialogSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TileStartWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartWindowStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileStartOverlayCornerRadius}" />
    </Style>

    <Style x:Key="TileStartCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TileStartCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource TileStartOverlayCornerRadius}" />
    </Style>

    <Style x:Key="TileStartButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TileStartControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource TileStartControlPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TileStartTextDisabledBrush}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TileStartButtonStyle}">
        <Setter Property="Foreground" Value="{x:Static local:Win10Theme.AccentForegroundBrush}" />
        <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{x:Static local:Win10Theme.AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{x:Static local:Win10Theme.AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TileStartTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TileStartControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileStartControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{x:Static local:Win10Theme.AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TileStartControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush"
                                    Value="{DynamicResource TileStartControlStrokeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1,1,1,2" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileStartCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TileStartTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder"
                                Width="18"
                                Height="18"
                                Background="{DynamicResource TileStartControlBackgroundBrush}"
                                BorderBrush="{DynamicResource TileStartControlStrokeHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock x:Name="CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{x:Static local:Win10Theme.AccentForegroundBrush}"
                                       Text="&#xE73E;"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource TileStartControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{x:Static local:Win10Theme.AccentBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>